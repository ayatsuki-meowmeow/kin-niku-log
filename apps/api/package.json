{
  "name": "@repo/api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "validate": "bun run lint && bun run check-types",
    "sample-seed": "bun --env-file=.dev.vars run scripts/seed.sample.ts",
    "generate": "openapi-typescript ../../openapi.yaml -o src/generated/api.d.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@neondatabase/serverless": "^1.1.0",
    "@repo/schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@hono/swagger-ui": "^0.6.1",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "cf": "^1.0.0-beta.12",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.2",
    "wrangler": "^4.141.0"
  }
}
